{
    "name": "hpc-global",
    "version": "1.0.0",
    "private": true,
    "description": "HPC Global — Hopepress Chapel website",
    "scripts": {
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "dev:server": "nodemon server/src/server.js",
        "dev:client": "cd client && vite",
        "build": "cd client && npx vite build",
        "start": "node server/src/server.js",
        "db:generate": "prisma generate --schema=server/src/prisma/schema.prisma",
        "db:migrate": "prisma migrate dev --schema=server/src/prisma/schema.prisma",
        "db:studio": "prisma studio --schema=server/src/prisma/schema.prisma",
        "db:seed": "node server/src/prisma/seed.js"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "@prisma/client": "^5.14.0",
        "axios": "^1.7.2",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^2.3.1",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.3.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "lucide-react": "^1.14.0",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^6.9.14",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-helmet-async": "^3.0.0",
        "react-hook-form": "^7.75.0",
        "react-icons": "^5.6.0",
        "react-router-dom": "^7.15.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.19",
        "concurrently": "^8.2.2",
        "nodemon": "^3.1.4",
        "postcss": "^8.4.40",
        "prisma": "^5.14.0",
        "tailwindcss": "^3.4.7",
        "vite": "^5.3.5"
    }
}
