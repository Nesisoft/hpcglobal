// HPC Workers — the church workers' attendance app.
//
// Everything here lives in the Postgres schema `workers` of the same Supabase
// database as the website, reached through the `workers_app` role, which owns
// that schema and has no rights on `public` (the website's tables). The schema
// comes from DATABASE_URL's `?schema=workers`, so Prisma reads and writes only
// there, and the website's own deploy-time sync, which looks only at `public`,
// never sees these tables.
//
// Schema changes reach production through server/src/prisma/sync.js at deploy
// time, which applies additions only — the same rules as the website.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

/// What a person may do beyond their own record. Heads of department are
/// workers with `isHod` set — a flag on the worker, not a role, so there is a
/// single meaning of "HOD" (the old PHP app had two that disagreed).
enum WorkerRole {
  WORKER
  ADMIN
  SUPER_ADMIN
}

/// PENDING until their HOD or an admin approves the sign-up. Only ACTIVE
/// workers can clock in or reach anything beyond their own profile.
enum WorkerStatus {
  PENDING
  ACTIVE
  DECLINED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  // Archived rather than deleted: past attendance and reports still name it.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workers     Worker[]
}

model Worker {
  id           String       @id @default(uuid())
  firstName    String
  lastName     String
  /// Always lower-case, so one address is one account.
  email        String       @unique
  /// Stored as dialled internationally, e.g. 233244123456 (see lib/phone.js).
  phone        String
  gender       Gender
  passwordHash String
  role         WorkerRole   @default(WORKER)
  status       WorkerStatus @default(PENDING)
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  isHod        Boolean      @default(false)

  /// Who approved the sign-up, kept as a snapshot so it reads the same after
  /// that person's account changes.
  approvedAt     DateTime?
  approvedById   String?
  approvedByName String?
  /// The reason given when a sign-up is declined or an account suspended,
  /// shown to the person on their waiting screen.
  statusNote     String?

  /// Set when an admin gives the worker a temporary password. Until they
  /// choose their own, the API answers nothing but the password change.
  mustChangePassword  Boolean   @default(false)
  /// A temporary password stops working after this (72 hours), so one read
  /// out over the phone and never used can't be guessed at for ever.
  tempPasswordExpires DateTime?
  /// Bumped to sign the worker out everywhere: every token carries the
  /// version it was issued at, and an older one is refused.
  tokenVersion       Int       @default(0)
  /// Password reset by emailed code. Only a hash is kept; the code itself
  /// exists only in the email.
  resetCodeHash      String?
  resetCodeExpires   DateTime?
  resetCodeAttempts  Int       @default(0)
  resetCodeSentAt    DateTime?
  /// A day's allowance across all codes, so asking for a new code doesn't buy
  /// five more guesses: at most 5 codes and 10 wrong guesses per 24 hours,
  /// counted from resetWindowStart.
  resetWindowStart      DateTime?
  resetCodesInWindow    Int       @default(0)
  resetFailuresInWindow Int       @default(0)

  attendance Attendance[]

  lastLogin DateTime?
  /// When anything an admin's form shows last changed — details, status,
  /// role, HOD flag, department — but not a sign-in or a reset code. An
  /// admin's edit carries the editedAt it was loaded with and is refused if
  /// this has moved since, so a form opened before someone else's change
  /// can't quietly undo it. (updatedAt moves on every write, sign-ins too.)
  editedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([departmentId, status])
  @@index([status])
}

/// Emails sent, counted per day (UTC, which is Accra time): one row for the
/// whole app ("all:2026-11-14") and one per sender's address
/// ("address:2026-11-14:203.0.113.0"). The app's Resend key is on the same
/// account as the website's, whose free plan allows 100 a day in all, so this
/// app stops well short of that — and no one address can spend much of it.
model EmailCount {
  key  String   @id
  day  String
  sent Int      @default(0)

  @@index([day])
}

/// Who changed what. Names are snapshots so an entry still reads correctly
/// after the people in it change or leave.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String
  /// e.g. "worker.approve", "department.update"
  action     String
  targetType String
  targetId   String?
  /// One line a person can read: "Approved Ama Mensah (Ushers)".
  summary    String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// ─── Services and clocking (part 2) ──────────────────────────────────────────

enum ServiceKind {
  REGULAR
  MIDWEEK
  CONFERENCE
  TRAINING
  SPECIAL
}

/// How a service's dates come round. WEEKLY on `weekday`; DAILY every day
/// from startsOn to endsOn (a week of fasting and prayer, a conference);
/// NONE once, on startsOn.
enum Recurrence {
  WEEKLY
  DAILY
  NONE
}

enum ClockMethod {
  GPS
  QR
  MANUAL
}

enum ArrivalStatus {
  ON_TIME
  LATE
  VERY_LATE
}

enum QrResult {
  OK
  BAD_CODE
  NOT_OPEN
  ALREADY
}

/// A service workers attend — "Dominion Encounter Service", Sundays 07:30.
/// Its dates are ServiceSessions, made automatically for the week ahead.
model Service {
  id         String      @id @default(uuid())
  name       String
  kind       ServiceKind @default(REGULAR)
  venueName  String?
  /// Where workers must be to clock in by GPS. Null until the office sets it
  /// (from inside the venue, with "use my current location").
  latitude   Float?
  longitude  Float?
  radiusM    Int         @default(100)
  recurrence Recurrence  @default(WEEKLY)
  /// 0 = Sunday … 6 = Saturday, for WEEKLY.
  weekday    Int?
  /// "HH:MM", Accra time (which is UTC all year).
  startTime  String
  endTime    String
  startsOn   DateTime?   @db.Date
  endsOn     DateTime?   @db.Date
  /// Counts towards absence in reports. A service workers may choose to
  /// attend (a 6 a.m. prayer meeting, say) can be switched off.
  expected   Boolean     @default(true)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  sessions   ServiceSession[]
}

/// One date of a service. Unique per service and date, so making the coming
/// week's sessions twice — or by two requests at once — makes them once.
model ServiceSession {
  id         String       @id @default(uuid())
  serviceId  String
  service    Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  date       DateTime     @db.Date
  startsAt   DateTime
  endsAt     DateTime
  /// Kept, not deleted, so a cancelled date is never made again.
  cancelled  Boolean      @default(false)
  note       String?
  /// Its times were set by hand (moved, or added as a one-off), so a change
  /// to the service's usual times leaves it alone.
  custom     Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  attendance Attendance[]

  @@unique([serviceId, date])
  @@index([startsAt])
}

/// A worker's attendance at one session: at most one each (the unique key is
/// what makes a double tap, or two phones at once, safe).
model Attendance {
  id               String         @id @default(uuid())
  workerId         String
  worker           Worker         @relation(fields: [workerId], references: [id], onDelete: Restrict)
  sessionId        String
  session          ServiceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  method           ClockMethod
  clockInAt        DateTime
  clockInLat       Float?
  clockInLng       Float?
  clockInAccuracy  Float?
  /// Metres from the venue when they clocked in by GPS.
  clockInDistance  Int?
  clockOutAt       DateTime?
  clockOutLat      Float?
  clockOutLng      Float?
  clockOutAccuracy Float?
  clockOutMethod   ClockMethod?
  status           ArrivalStatus
  lateMinutes      Int            @default(0)
  minutesPresent   Int?
  leftEarlyMinutes Int?
  /// Closed by the app after the clock-out time passed without a clock-out.
  /// Counted as attended (they clocked in at the venue), minutes unknown.
  autoClockedOut   Boolean        @default(false)
  /// For records an HOD or admin adds or changes by hand (part 3).
  markedById       String?
  markedByName     String?
  markReason       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([workerId, sessionId])
  @@index([sessionId])
  @@index([workerId, clockInAt])
}

/// The office's rules for clocking, one row.
model Settings {
  id                   String   @id @default("singleton")
  /// Minutes after the start that still count as on time.
  graceMinutes         Int      @default(15)
  /// Later than this many minutes after the start is very late.
  veryLateMinutes      Int      @default(30)
  /// Clock-in opens this many minutes before the start.
  opensBeforeMinutes   Int      @default(60)
  /// Clock-out stays open this many minutes after the end.
  clockOutAfterMinutes Int      @default(60)
  /// Less time than this between clock-in and clock-out is "short".
  minValidMinutes      Int      @default(30)
  /// Leaving more than this many minutes before the end is "left early".
  leftEarlyMinutes     Int      @default(15)
  defaultRadiusM       Int      @default(100)
  updatedByName        String?
  updatedAt            DateTime @updatedAt
}

/// Every QR clock-in attempt, good or bad: who, which session, what happened.
model QrScan {
  id        String   @id @default(uuid())
  workerId  String?
  sessionId String?
  result    QrResult
  address   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
