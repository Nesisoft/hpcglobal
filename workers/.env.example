# Local development. Copy to .env (git-ignored) and point at a local Postgres —
# never the Supabase database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hpc_workers_dev?schema=workers
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
APP_URL=http://localhost:5174
# Leave unset locally: reset codes are printed in the API's console instead.
# RESEND_API_KEY=
# MAIL_FROM=HPC Workers <no-reply@hpcglobal.org>
