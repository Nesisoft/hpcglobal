{
  "_comment": "Single source of truth for the password rules. Read directly by the Express server (require) and by the React client (Vite JSON import), so the live checklist a person sees and the check the server performs can never drift apart. JSON rather than a module because the server is CommonJS and the client is ESM.",
  "minLength": 10,
  "maxLength": 128,
  "rules": [
    { "id": "length",      "label": "At least 10 characters",              "type": "minLength", "value": 10 },
    { "id": "lowercase",   "label": "A lowercase letter (a–z)",            "type": "regex",     "value": "[a-z]" },
    { "id": "uppercase",   "label": "An uppercase letter (A–Z)",           "type": "regex",     "value": "[A-Z]" },
    { "id": "number",      "label": "A number (0–9)",                      "type": "regex",     "value": "[0-9]" },
    { "id": "symbol",      "label": "A symbol (! @ # ? and the like)",     "type": "regex",     "value": "[^A-Za-z0-9]" },
    { "id": "notRepeated", "label": "At least 5 different characters",      "type": "minDistinct", "value": 5 },
    { "id": "notCommon",   "label": "Not an easily guessed password",      "type": "notCommon" },
    { "id": "notPersonal", "label": "Does not contain your name or email", "type": "notPersonal" }
  ],
  "commonPasswords": [
    "password", "password1", "password123", "passw0rd", "p@ssword", "p@ssw0rd",
    "12345678", "123456789", "1234567890", "qwerty", "qwerty123", "qwertyuiop",
    "abc12345", "abcd1234", "letmein", "welcome", "welcome1", "admin", "admin123",
    "administrator", "iloveyou", "monkey", "dragon", "sunshine", "princess",
    "football", "baseball", "superman", "trustno1", "changeme", "secret",
    "hpcglobal", "hopepress", "hopepresschapel", "church", "church123",
    "jesus", "jesus123", "jesuschrist", "godisgood", "hallelujah", "blessed",
    "ghana", "ghana123", "accra", "pastor", "pastor123", "usher", "ushering",
    "choir", "choir123", "deacon", "elder", "ministry", "worship"
  ]
}
