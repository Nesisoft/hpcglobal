# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hpcglobal"

# JWT
JWT_SECRET="your-jwt-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"

# Paystack
PAYSTACK_SECRET_KEY="sk_live_..."
PAYSTACK_PUBLIC_KEY="pk_live_..."

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# YouTube Data API v3
YOUTUBE_API_KEY="your-youtube-api-key"
YOUTUBE_CHANNEL_ID="UCxxxxxxxxxxxxxxxxxxxxxxxx"

# Email (SMTP — Hostinger)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="noreply@hpcglobal.org"
SMTP_PASS="your-email-account-password"
SMTP_FROM="noreply@hpcglobal.org"
OFFICE_EMAIL="info@hpcglobal.org"

# SMS / WhatsApp (Arkesel)
# Sign up at https://arkesel.com → API Keys → copy your key
ARKESEL_API_KEY="your-arkesel-api-key"
# The office/coordinator phone number that receives SMS alerts (international format)
OFFICE_PHONE="+233XXXXXXXXX"

# Supabase (server-side — used for partner accounts + activation emails)
# Project URL and keys are in Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-keep-secret"

# Supabase (client-side — must be exposed to the browser via Vite)
# IMPORTANT: these belong in client/.env (Vite only reads VITE_* from the client root)
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="anon-public-key"

# App
APP_URL="https://www.hpcglobal.org"
