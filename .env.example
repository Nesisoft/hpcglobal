# Database
# Local development — a direct Postgres connection.
DATABASE_URL="postgresql://user:password@localhost:5432/hpcglobal"

# Production (Vercel + Supabase): point DATABASE_URL at the *transaction mode*
# pooler on port 6543, not session mode on 5432. Session mode gives every client
# its own dedicated Postgres connection and caps them at pool_size (15), which a
# handful of concurrent serverless invocations exhausts:
#   FATAL: (EMAXCONNSESSION) max clients reached in session mode
# Transaction mode multiplexes instead, so the same pool serves far more clients.
#
#   DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# server/src/lib/prisma.js adds pgbouncer/connection_limit/pool_timeout defaults
# when they are missing, so an existing URL keeps working — but setting them
# explicitly here is clearer.
#
# DIRECT_URL is the unpooled connection (port 5432, db.<ref>.supabase.co) used by
# `prisma migrate` and `prisma db push`; poolers cannot run DDL.
DIRECT_URL="postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres"

# JWT
JWT_SECRET="your-jwt-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"

# Paystack
PAYSTACK_SECRET_KEY="sk_live_..."
PAYSTACK_PUBLIC_KEY="pk_live_..."

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# YouTube Data API v3
YOUTUBE_API_KEY="your-youtube-api-key"
YOUTUBE_CHANNEL_ID="UCxxxxxxxxxxxxxxxxxxxxxxxx"

# Email — Resend (preferred) with SMTP as the fallback
# Set RESEND_API_KEY and every message goes through Resend, which also enables
# bulk sends (one API call per 100 recipients instead of 100 SMTP handshakes —
# a serverless function would time out long before finishing those).
# Leave it unset and the SMTP settings below are used exactly as before.
# Key: https://resend.com/api-keys. The sending domain must be verified there,
# and SMTP_FROM must be an address on that domain or Resend rejects the send.
RESEND_API_KEY="re_..."
EMAIL_FROM_NAME="HPC Global"

# Email (SMTP — Hostinger). Used when RESEND_API_KEY is absent.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="noreply@hpcglobal.org"
SMTP_PASS="your-email-account-password"
SMTP_FROM="noreply@hpcglobal.org"
OFFICE_EMAIL="info@hpcglobal.org"

# SMS — Hubtel
# Dashboard → API Keys gives a Client ID and Client Secret, which are sent as
# HTTP Basic auth. HUBTEL_SENDER_ID is the name recipients see as the sender;
# it must be registered with Hubtel first (max 11 characters) or messages are
# rejected. Leave these unset and SMS is skipped rather than failing — the
# registration itself still succeeds.
HUBTEL_SMS_CLIENT_ID="your-hubtel-client-id"
HUBTEL_SMS_CLIENT_SECRET="your-hubtel-client-secret"
HUBTEL_SENDER_ID="HPCGlobal"
# Only needed if Hubtel moves the endpoint; the default is the live one.
# HUBTEL_SMS_BASE_URL="https://sms.hubtel.com/v1/messages"

# The office/coordinator phone number that receives SMS alerts (international format)
OFFICE_PHONE="+233XXXXXXXXX"

# Supabase (server-side — used for partner accounts + activation emails)
# Project URL and keys are in Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-keep-secret"

# Supabase (client-side — must be exposed to the browser via Vite)
# IMPORTANT: these belong in client/.env (Vite only reads VITE_* from the client root)
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="anon-public-key"

# Short links for sharing events (optional)
# Without a token, share links are the site's own /e/<slug> URLs — already
# short, and they carry the preview tags WhatsApp and Facebook read. A
# shortener only makes the link tidier; it cannot create a preview on its own.
# Token: https://tinyurl.com/app/settings/api
# TINYURL_API_TOKEN="your-tinyurl-api-token"
# TINYURL_DOMAIN="tinyurl.com"

# App
# Also the origin baked into shared event links, so it must be the public site.
APP_URL="https://www.hpcglobal.org"

# How long a bulk send may run before it stops and saves its place, in
# milliseconds. The default (45000) suits the maxDuration of 60 set for
# api/index.js in vercel.json. Lower it if the deployment allows less, or a
# send will be killed mid-flight instead of stopping cleanly.
# CAMPAIGN_TIME_BUDGET_MS=45000
